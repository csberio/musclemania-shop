---
import type { Product } from '../data/products';

interface Props {
  product: Product;
  featured?: boolean;
}

const { product, featured = false } = Astro.props;
const searchText = [
  product.brand,
  product.name,
  product.category,
  product.application,
  product.size,
]
  .filter(Boolean)
  .join(' ');
---

<article
  class:list={['product-card', { 'product-card--featured': featured }]}
  data-product-id={product.id}
  data-product-brand={product.brand}
  data-product-name={product.name}
  data-product-size={product.size ?? ''}
  data-product-category={product.category}
  data-product-search={searchText}
  data-catalog-card={!featured ? '' : undefined}
>
  <div class="product-card__media">
    {product.image ? (
      <img
        src={product.image}
        alt={product.imageAlt ?? `${product.brand} ${product.name}`}
        width="560"
        height="420"
        loading={featured ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <div class="product-card__fallback" aria-hidden="true">{product.brand.slice(0, 3)}</div>
    )}
    <span class="product-card__brand">{product.brand}</span>
  </div>

  <div class="product-card__body">
    <p class="product-card__category">{product.category}</p>
    <h3>{product.name}</h3>
    {product.application && <p class="product-card__description">{product.application}</p>}

    <div class="product-card__footer">
      <span class="product-card__size">{product.size ?? 'Presentación por confirmar'}</span>
      <button class="button button--small product-card__add" type="button" data-add-product>
        <span>Añadir</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
          <path d="M12 5v14M5 12h14"></path>
        </svg>
      </button>

      <div class="quantity-control" data-quantity-control hidden>
        <button type="button" data-decrease aria-label={`Reducir cantidad de ${product.name}`}>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
            <path d="M5 12h14"></path>
          </svg>
        </button>
        <output aria-live="polite" data-quantity>0</output>
        <button type="button" data-increase aria-label={`Aumentar cantidad de ${product.name}`}>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
            <path d="M12 5v14M5 12h14"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</article>

